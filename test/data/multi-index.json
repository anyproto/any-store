{
  "indexes": [["score"], ["age"], ["name"]],
  "data": [
    {"id": 1, "score": 10, "age": 20, "name": "alice"},
    {"id": 2, "score": 20, "age": 30, "name": "bob"},
    {"id": 3, "score": 10, "age": 30, "name": "charlie"},
    {"id": 4, "score": 30, "age": 20, "name": "dave"},
    {"id": 5, "score": 10, "age": 70, "name": "eve"},
    {"id": 6, "score": 20, "age": 70, "name": "frank"},
    {"id": 7, "score": 30, "age": 30, "name": "grace"},
    {"id": 8, "score": 10, "age": 40, "name": "heidi"},
    {"id": 9, "score": 20, "age": 20, "name": "ivan"},
    {"id": 10, "score": 30, "age": 70, "name": "judy"}
  ],
  "tests": [
    {
      "cond": {"score": 10, "age": 70},
      "expectedIds": [5]
    },
    {
      "cond": {"score": 10, "age": 30},
      "expectedIds": [3]
    },
    {
      "cond": {"score": 10},
      "expectedIds": [1, 3, 5, 8]
    },
    {
      "cond": {"score": 10, "age": {"$gt": 30}},
      "expectedIds": [5, 8]
    },
    {
      "cond": {"score": {"$lt": 25}, "age": 70},
      "expectedIds": [5, 6]
    },
    {
      "sort": ["age", "name"],
      "limit": 5,
      "expectedIds": [1, 4, 9, 2, 3]
    },
    {
      "sort": ["-age", "name"],
      "limit": 3,
      "expectedIds": [5, 6, 10]
    },
    {
      "cond": {"score": 10},
      "sort": ["age"],
      "expectedIds": [1, 3, 8, 5]
    },
    {
      "cond": {"score": 10, "age": 70},
      "sort": ["name"],
      "expectedIds": [5]
    },
    {
      "cond": {"age": {"$gte": 30}},
      "expectedIds": [2, 3, 7, 8, 5, 6, 10]
    }
  ]
}
