{
  "data": [
    {"id": 0, "n": -10},
    {"id": 1, "n": -5},
    {"id": 2, "n": -1},
    {"id": 3, "n": 0},
    {"id": 4, "n": 1},
    {"id": 5, "n": 5},
    {"id": 6, "n": 10}
  ],
  "indexes": [["n"]],
  "tests": [
    {
      "name": "range including negatives",
      "cond": {"n": {"$gte": -5, "$lte": 5}},
      "expectedCount": 5
    },
    {
      "name": "only negatives",
      "cond": {"n": {"$lt": 0}},
      "expectedCount": 3
    },
    {
      "name": "sort ascending",
      "sort": ["n"],
      "expectedIds": [0, 1, 2, 3, 4, 5, 6]
    },
    {
      "name": "sort descending",
      "sort": ["-n"],
      "expectedIds": [6, 5, 4, 3, 2, 1, 0]
    }
  ]
}
